PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=alumindo_sejahtera
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# --- Hanya untuk deploy (Vercel + MySQL cloud). Kosongkan saat development lokal. ---
# Aktifkan jika penyedia MySQL cloud mewajibkan SSL/TLS (TiDB Cloud, dll.)
# DB_SSL=true
# Gambar disimpan di Vercel Blob jika store dihubungkan ke project (BLOB_STORE_ID otomatis)
# atau token diisi manual. Jika dua-duanya kosong, gambar disimpan di backend/uploads.
# BLOB_READ_WRITE_TOKEN=
